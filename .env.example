SALUS_CLIENT_ID=
SALUS_CLIENT_SECRET=
SALUS_TOKEN_URL=https://guardian.beta.salussafety.io/token
SALUS_SCOPE=sls:idn

# --- Internal API ---
# Long random string; callers send "Authorization: Bearer <API_TOKEN>".
API_TOKEN=

# --- Acumatica (secrets) ---
# Connected application registered in Acumatica (SM303010), password flow.
ACUMATICA_CLIENT_ID=
ACUMATICA_CLIENT_SECRET=
# Dedicated API user with access only to field tickets + the report.
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=

# --- Adobe Acrobat Sign (secrets) ---
# Integration key or OAuth access token with agreement_read, agreement_write, agreement_send scopes.
ADOBE_SIGN_ACCESS_TOKEN=
